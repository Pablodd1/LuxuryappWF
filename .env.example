# ==========================================
# CURATEDLUX ENVIRONMENT VARIABLES SETUP
# ==========================================

# ------------------------------------------
# 1. AI API KEYS & CONFIGURATION
# ------------------------------------------
# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Used for multi-angle luxury asset visual inspection, OCR warranty card processing,
# and algorithmic market valuation estimation.
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------
# 2. SERVER & APPLICATION ROUTING
# ------------------------------------------
# PORT: Application port (defaults to 3000 in Cloud Run / local dev)
PORT=3000

# NODE_ENV: Node environment mode ('development' or 'production')
NODE_ENV="development"

# APP_URL: The primary host URL for self-referential links, OAuth redirects, and API endpoints.
APP_URL="http://localhost:3000"

# ------------------------------------------
# 3. DATABASE & PERSISTENCE OPTIONS (OPTIONAL)
# ------------------------------------------
# OPTION A: FIREBASE / FIRESTORE (Recommended for Real-time Trade & Escrow Persistence)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"

# OPTION B: POSTGRESQL / CLOUD SQL (Recommended for Enterprise ERP Synchronization)
# DATABASE_URL="postgresql://user:password@localhost:5432/curatedlux_db?sslmode=require"

# ------------------------------------------
# 4. STORAGE & CDN INTEGRATION (OPTIONAL)
# ------------------------------------------
# AWS_S3_BUCKET_NAME="curatedlux-4k-vault-videos"
# AWS_ACCESS_KEY_ID="your_aws_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret"
# AWS_REGION="us-east-1"
